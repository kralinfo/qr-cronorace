{
  "rewrites": [
    {
      "source": "/chronometer.html",
      "destination": "/chronometer.html"
    },
    {
      "source": "/((?!assets/|icon.svg|manifest.webmanifest|sw.js|workbox-.*|chronometer.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ]
}

